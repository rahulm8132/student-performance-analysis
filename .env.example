# Local MongoDB (make sure the MongoDB service is running)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=college_analytics

# Change this to a long, random value before deployment
SECRET_KEY=replace-this-with-a-long-random-secret

# Seeded demo accounts (used by seed_data.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234
FACULTY_USERNAME=faculty
FACULTY_PASSWORD=Faculty@1234
PLACEMENT_USERNAME=placement
PLACEMENT_PASSWORD=Placement@1234

# Optional settings
ATTENDANCE_THRESHOLD=65
SESSION_COOKIE_SECURE=false
